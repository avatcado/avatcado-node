{
  "name": "@avatcado/node",
  "version": "0.8.0",
  "description": "Official TypeScript SDK for the Avatcado VAT and GST validation API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vat",
    "gst",
    "validation",
    "eu",
    "uk",
    "switzerland",
    "norway",
    "australia",
    "tax",
    "avatcado",
    "vies",
    "hmrc"
  ],
  "author": "Avatcado",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/avatcado/avatcado-node.git"
  },
  "homepage": "https://avatcado.com",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
